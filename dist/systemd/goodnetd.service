# goodnetd.service — systemd unit for the GoodNet daemon binary.
#
# The daemon ships from the `goodnet-io/goodnetd` repo (the kernel
# repo carries this unit only as a packaging convenience). Operators
# install at /etc/systemd/system/goodnetd.service, drop a `node.json`
# and `plugins.json` into /etc/goodnet/, and run:
#
#     systemctl enable --now goodnetd
#
# The unit runs the daemon's `run` subcommand which orchestrates
# kernel + plugin load + identity load per the manifest.

[Unit]
Description=GoodNet network daemon
Documentation=https://github.com/GoodNet-io/goodnetd
After=network-online.target
Wants=network-online.target

[Service]
# Pre-deploy validation. ExecStartPre cuts a malformed config off at
# unit-start time rather than letting `run` crash mid-handshake.
ExecStartPre=/usr/bin/goodnetd config validate /etc/goodnet/node.json

# Production entry. Both files are required; the unit fails fast if
# either is missing or malformed.
ExecStart=/usr/bin/goodnetd run --config /etc/goodnet/node.json --manifest /etc/goodnet/plugins.json

# Cooperative shutdown. The kernel polls `is_shutdown_requested`
# from inside async callbacks (host-api.en.md §10) and exits early on
# SIGTERM; 30s is generous for plugin drain.
KillSignal=SIGTERM
TimeoutStopSec=30

# A node failure is a configuration or plugin error — surface it
# loudly through systemd rather than silent restarts. Operators who
# want auto-restart override `Restart=` in a drop-in.
Restart=no

# Run as an unprivileged user. The package install script creates
# `goodnet:goodnet` and chowns /etc/goodnet/ + /var/lib/goodnet/.
User=goodnet
Group=goodnet

# State directory for any plugin that wants persistent state under
# the kernel's lifecycle (DHT, sync, etc.). Per-plugin subdirs
# materialise on first write.
StateDirectory=goodnet
StateDirectoryMode=0750

# Hardening. The kernel does not need root, raw sockets, or the
# host's namespace tree.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
